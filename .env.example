# ---------------------------------------------------------------
# AI Office — environment variables (copy to .env and adjust)
# Never commit the real .env file.
# ---------------------------------------------------------------

# PostgreSQL / Redis
DATABASE_URL=postgres://aioffice:aioffice@localhost:5432/aioffice
TEST_DATABASE_URL=postgres://aioffice:aioffice@localhost:5432/aioffice_test
REDIS_URL=redis://localhost:6379

# Public origin of the web app (CORS + Better Auth trusted origin)
WEB_ORIGIN=http://localhost:3000
# Base URL where /api/auth is reachable from the browser (the web origin, proxied to the API)
BETTER_AUTH_URL=http://localhost:3000
# >= 32 random chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me-123
# >= 16 random chars; encrypts provider API keys at rest (AES-256-GCM).
# Changing it makes stored keys unreadable (re-enter them in Settings).
ENCRYPTION_KEY=change-me-encryption-key-please

# API server
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# Run DB migrations on API start (useful in containers)
RUN_MIGRATIONS=false
# Show the "Explore the demo office" button on the login page (dev/demo only)
DEMO_LOGIN_ENABLED=true
# Allow a custom URL for local OpenAI-compatible servers (Ollama). The API server
# will call that URL — keep it false on multi-tenant deployments (SSRF risk).
# Defaults to true outside production.
ALLOW_CUSTOM_PROVIDER_URLS=true

# Next.js → API proxy target (server-side only)
API_INTERNAL_URL=http://localhost:4000

# Worker
WORKER_CONCURRENCY=8
# Delay between streamed chunks of the demo provider (ms)
DEMO_CHUNK_DELAY_MS=35

# S3-compatible storage for uploaded documents (MinIO locally). Optional.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-office
S3_ACCESS_KEY_ID=aioffice
S3_SECRET_ACCESS_KEY=aioffice-minio-secret

# AI provider keys are NOT configured here: add them in the app
# (Settings → Providers: Groq, OpenRouter, Ollama, Anthropic, OpenAI).
# They are stored encrypted per workspace.
TEST_REDIS_URL=redis://localhost:6379/15
