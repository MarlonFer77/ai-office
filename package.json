{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@ai-office/web --filter=@ai-office/api --filter=@ai-office/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ai-office/database db:generate",
    "db:migrate": "pnpm --filter @ai-office/database db:migrate",
    "start": "turbo run start --parallel --filter=@ai-office/web --filter=@ai-office/api --filter=@ai-office/worker",
    "db:seed": "pnpm --filter @ai-office/api seed",
    "services:up": "docker compose up -d postgres redis",
    "services:down": "docker compose --profile storage down",
    "services:storage": "docker compose --profile storage up -d minio minio-init"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
